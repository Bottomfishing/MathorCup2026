  "config": {
    "protocol_id": "q1_decision_det_20261028",
    "revision": "1 (T1 batch-independent decision layer)",
    "frozen_before_results": true,
    "post_result_threshold_retuning": false,
    "task": "T1: replace the batch-dependent per-fold top-k promotion with a per-sample fixed-threshold decision whose parameters are frozen from training-internal OOF probabilities",
    "date": "2026-10-28",
    "main_decision_object": "panel_weighted_median_integer_grade_0_6 (250 beers x 50 targets, 12500 cells; the two acetaldehyde card slots stay NA)",
    "decision_rule": {
      "name": "fixed_threshold_quantile",
      "middle": "min(legacy_integer_median, 4)",
      "grade_6": "p6 >= tau_6[target]",
      "grade_5": "not grade_6 and p_ge5 >= tau_ge5[target]",
      "otherwise": "min(legacy_integer_median, 4)",
      "per_sample": true,
      "uses_batch_size": false,
      "uses_rank_within_batch": false,
      "uses_row_position_for_ties": false,
      "parent_child_cap": "after the per-sample assignment, child_grade = min(child_grade, parent_grade) for the 24 checkbox_zero_or_parent pairs (same deterministic post-processing as before)",
      "binding": "same implementation used by the official OOF evaluation script and by current_runtime/inference"
    },
    "threshold_estimation": {
      "event_ge5": "panel_weighted_median >= 5",
      "event_6": "panel_weighted_median >= 6",
      "source": "inner-OOF predicted probabilities of the outer-training beers only; outer-validation labels never enter threshold estimation",
      "rate": "r = fraction of the target's training cells whose panel median reaches the event",
      "support": "n = number of training cells for that target in the estimation slice",
      "quantile": "k = ceil(r * n) clipped to [1, n] when r > 0; tau = k-th largest probability over the slice",
      "fallback": "r == 0 or n == 0 -> tau = +inf, i.e. the target emits no 5 (or no 6); such targets are listed in the summary",
      "frozen": "tau is computed once from training-internal OOF probabilities and stored in the model bundle; inference never recomputes it from the request",
      "runtime_slice": "data/current/risk_full_training.csv.gz source=extra_trees (historical inner-OOF probabilities of all 250 training beers) with the fixed full-training panel medians; documented caveat: those probabilities are inner-OOF while the deployed model emits full-fit probabilities, which is the conservative direction (deployed probabilities are not used to choose tau)"
    },
    "legacy_baseline": {
      "name": "non_forced_cumulative_probability_topk_with_parent_child_cap",
      "status": "historical baseline only; kept to reproduce old tables, no longer the official path",
      "why_replaced": "k = round(rate * n_rows) depends on the request batch; the same beer/target can change grade when the batch changes (217 cells whole-batch vs per-row; 214 -> 0 >=5 cells when scored row by row)"
    },
