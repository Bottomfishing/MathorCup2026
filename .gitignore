__pycache__/
*.pyc
.venv/

# Local caches, model binaries and source archives can be regenerated.
*.joblib
*.npy
checkpoints/
outputs/**/source_snapshot/

# Downloaded reference workbook contains participant metadata; fetch locally.
data/reference/**/*.xlsx
# External raw panel records are fetched by checksum; do not publish comments in Git.
data/reference/zenodo23624915/Raw sensory data anonymized.csv

# Superseded development outputs. Keep the documented active runs.
outputs/p0_audit_20261023_v1/
outputs/p0_audit_20261023_v2/
outputs/q2_review_20261024/
outputs/q2_review_20261024_v2/
outputs/q3_exploratory_20261024_v1/
outputs/q3_threshold_scenarios_20261024/

# Local credentials and editor/system files.
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db

# Local rebuilds duplicate versioned scientific tables; publish their reports/logs.
outputs/revalidation_20261024/modeling/
outputs/revalidation_20261024/style/
outputs/revalidation_20261024/resolution/
outputs/revalidation_20261024/reference/
outputs/revalidation_20261024/ordinal/
outputs/revalidation_20261024/q2_reliability/
outputs/revalidation_20261024/ordinal_prediction_smoke/*.csv
outputs/revalidation_20261024/ordinal_prediction_with_intervals/*.csv
outputs/reproduction_latest_20261024/*
!outputs/reproduction_latest_20261024/latest_revalidation.json
!outputs/reproduction_latest_20261024/latest_logs/
outputs/q3_reference_diagnostics_20261024/

# Current selected workflow: keep its report/logs, not duplicate rebuilt tables/models.
outputs/current_reproduction_20261025/*
!outputs/current_reproduction_20261025/reproduction.json
!outputs/current_reproduction_20261025/logs/

# Explicit task2 full-training CLI checks duplicate model inference, not OOF evidence.
outputs/task2_ordinal_20261025/prediction_smoke/*.csv
# R2 CLI smoke repeats the full-fit prediction tables; retain its metadata only.
outputs/r2_raw_q1_20261026/prediction_smoke/*.csv
# R2b: retain final CLI metadata, not repeated inference CSVs or the earlier smoke.
outputs/r2b_tail_risk_20261026/prediction_smoke/
outputs/r2b_tail_risk_20261026/prediction_smoke_final/
